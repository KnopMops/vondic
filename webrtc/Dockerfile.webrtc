# Multi-stage Dockerfile for Vondic WebRTC & Signaling Service (Golang)
FROM golang:1.24-alpine AS builder

WORKDIR /build

# Copy dependency manifests
COPY webrtc/go.mod webrtc/go.sum ./
RUN go mod download

# Copy source code
COPY webrtc/ ./

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /build/webrtc-server ./cmd/server

# Production image
FROM alpine:3.21

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=builder /build/webrtc-server /app/webrtc-server

# Non-root user for security
RUN adduser -D -u 10001 appuser
USER appuser

EXPOSE 5000

ENTRYPOINT ["/app/webrtc-server"]
